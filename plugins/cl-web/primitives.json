{
  "engine": "web",
  "notes": "Install only what the project uses. Pin exact versions in package.json (no ^ or ~ for engine libraries) and commit the lockfile. Versions read from registry.npmjs.org on 2026-11-15; see skills/web-setup/references/versions.md.",
  "primitives": [
    { "name": "Node.js", "kind": "cli", "source": "https://nodejs.org/en/about/previous-releases", "install": "Install the current LTS from nodejs.org or a version manager; Capacitor 8 needs Node 22 or later", "license": "MIT", "required": true, "verified": "2026-11-15" },
    { "name": "Vite", "kind": "cli", "source": "https://vite.dev/guide/", "install": "npm create vite@9.3.4 <game> -- --template vanilla-ts", "version": "8.3.8", "license": "MIT", "required": true, "verified": "2026-11-15" },
    { "name": "TypeScript", "kind": "package", "source": "https://www.npmjs.com/package/typescript", "install": "npm i -D -E typescript@7.0.2", "version": "7.0.2", "license": "Apache-2.0", "required": true, "verified": "2026-11-15", "note": "TypeScript 7 is the native compiler line. If a tool in the chain still needs the 5.x JavaScript compiler API, pin the newest 5.x the tool supports and record why. TODO(verify: depends on each project's tool chain)" },
    { "name": "Phaser", "kind": "library", "source": "https://github.com/phaserjs/phaser", "install": "npm i -E phaser@4.2.1", "version": "4.2.1", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Phaser agent skills", "kind": "skill-pack", "source": "https://github.com/phaserjs/phaser/tree/master/skills", "install": "Copy or point the agent at the skills/ folder from the Phaser repo tag that matches the installed Phaser version", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Phaser project template", "kind": "cli", "source": "https://www.npmjs.com/package/@phaserjs/create-game", "install": "npm create @phaserjs/game@1.3.2", "version": "1.3.2", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "PixiJS", "kind": "library", "source": "https://pixijs.com/llms.txt", "install": "npm i -E pixi.js@8.23.0", "version": "8.23.0", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Three.js", "kind": "library", "source": "https://threejs.org/docs/llms.txt", "install": "npm i -E three@0.187.0 && npm i -D @types/three", "version": "0.187.0", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Babylon.js", "kind": "library", "source": "https://github.com/BabylonJS/Babylon.js", "install": "npm i -E @babylonjs/core@9.36.0", "version": "9.36.0", "license": "Apache-2.0", "required": false, "verified": "2026-11-15" },
    { "name": "Excalibur", "kind": "library", "source": "https://www.npmjs.com/package/excalibur", "install": "npm i -E excalibur@1.0.1", "version": "1.0.1", "license": "BSD-2-Clause", "required": false, "verified": "2026-11-15" },
    { "name": "Rapier (2D or 3D, compat build)", "kind": "library", "source": "https://github.com/dimforge/rapier", "install": "npm i -E @dimforge/rapier2d-compat@0.21.0  (or @dimforge/rapier3d-compat@0.21.0)", "version": "0.21.0", "license": "Apache-2.0", "required": false, "verified": "2026-11-15" },
    { "name": "Howler.js", "kind": "library", "source": "https://github.com/goldfire/howler.js", "install": "npm i -E howler@2.2.4", "version": "2.2.4", "license": "MIT", "required": false, "verified": "2026-11-15", "note": "Last release 2023-09-19. Stable but quiet; prefer the engine's audio module when it has one" },
    { "name": "idb-keyval", "kind": "library", "source": "https://github.com/jakearchibald/idb-keyval", "install": "npm i -E idb-keyval@6.3.0", "version": "6.3.0", "license": "Apache-2.0", "required": false, "verified": "2026-11-15" },
    { "name": "Vitest", "kind": "package", "source": "https://github.com/vitest-dev/vitest", "install": "npm i -D -E vitest@5.1.0", "version": "5.1.0", "license": "MIT", "required": true, "verified": "2026-11-15" },
    { "name": "Playwright Test", "kind": "package", "source": "https://github.com/microsoft/playwright", "install": "npm i -D -E @playwright/test@1.65.1 && npx playwright install --with-deps chromium", "version": "1.65.1", "license": "Apache-2.0", "required": true, "verified": "2026-11-15" },
    { "name": "Playwright MCP", "kind": "mcp", "source": "https://github.com/microsoft/playwright-mcp", "install": "claude mcp add playwright npx @playwright/mcp@0.0.85", "version": "0.0.85", "license": "Apache-2.0", "required": false, "verified": "2026-11-15" },
    { "name": "Chrome DevTools MCP", "kind": "mcp", "source": "https://github.com/ChromeDevTools/chrome-devtools-mcp", "install": "Claude Code: /plugin marketplace add ChromeDevTools/chrome-devtools-mcp, then /plugin install chrome-devtools-mcp@chrome-devtools-plugins. Other clients: npx -y chrome-devtools-mcp@1.13.0", "version": "1.13.0", "license": "Apache-2.0", "required": false, "verified": "2026-11-15" },
    { "name": "Capacitor (core, CLI, Android, iOS)", "kind": "cli", "source": "https://capacitorjs.com/docs/getting-started", "install": "npm i -E @capacitor/core@8.6.2 && npm i -D -E @capacitor/cli@8.6.2 && npm i -E @capacitor/android@8.6.2 @capacitor/ios@8.6.2", "version": "8.6.2", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Capacitor Preferences", "kind": "package", "source": "https://www.npmjs.com/package/@capacitor/preferences", "install": "npm i -E @capacitor/preferences@8.0.1", "version": "8.0.1", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Capacitor App", "kind": "package", "source": "https://www.npmjs.com/package/@capacitor/app", "install": "npm i -E @capacitor/app@8.1.2", "version": "8.1.2", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Capacitor Assets (icons and splash)", "kind": "cli", "source": "https://www.npmjs.com/package/@capacitor/assets", "install": "npm i -D -E @capacitor/assets@4.0.0", "version": "4.0.0", "license": "MIT", "required": false, "verified": "2026-11-15", "note": "Compatibility with Capacitor 8 projects TODO(verify: package.json lists no Capacitor peer dependency and the README names no supported range)" },
    { "name": "Electron", "kind": "package", "source": "https://github.com/electron/electron", "install": "npm i -D -E electron@45.3.2", "version": "45.3.2", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Electron Forge", "kind": "cli", "source": "https://github.com/electron/forge", "install": "npm i -D -E @electron-forge/cli@8.0.1 && npx electron-forge import", "version": "8.0.1", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "electron-builder", "kind": "cli", "source": "https://github.com/electron-userland/electron-builder", "install": "npm i -D -E electron-builder@26.18.0", "version": "26.18.0", "license": "MIT", "required": false, "verified": "2026-11-15" },
    { "name": "Tauri CLI", "kind": "cli", "source": "https://v2.tauri.app/start/", "install": "npm i -D -E @tauri-apps/cli@2.12.4 && npx tauri init", "version": "2.12.4", "license": "Apache-2.0 OR MIT", "required": false, "verified": "2026-11-15", "note": "Needs a Rust toolchain; on Windows also WebView2 (preinstalled on Windows 11). Windows needs the Microsoft C++ Build Tools (Desktop development with C++) and Rust via rustup with the MSVC toolchain. Prerequisites: https://v2.tauri.app/start/prerequisites/" },
    { "name": "steamworks.js (Electron)", "kind": "package", "source": "https://github.com/ceifa/steamworks.js", "install": "npm i -E steamworks.js@0.4.0", "version": "0.4.0", "license": "MIT", "required": false, "verified": "2026-11-15", "note": "Last release 2024-08-06; upstream repo quiet. Overlay helper has open crash and no-show issues. Test overlay on every OS you ship" },
    { "name": "steamworks-ffi-node (Electron)", "kind": "package", "source": "https://www.npmjs.com/package/steamworks-ffi-node", "install": "npm i -E steamworks-ffi-node@0.11.3", "version": "0.11.3", "license": "MIT", "required": false, "verified": "2026-11-15", "note": "Newer wrapper (2026). Electron overlay support is marked experimental by its author" },
    { "name": "steamworks crate (Tauri)", "kind": "library", "source": "https://crates.io/crates/steamworks", "install": "cargo add steamworks@0.13.1  (in src-tauri)", "version": "0.13.1", "license": "MIT OR Apache-2.0", "required": false, "verified": "2026-11-15" }
  ]
}
